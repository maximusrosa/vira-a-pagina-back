// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  WAITING_APPROVAL
  ACTIVE
}

enum BookCondition {
  LIKE_NEW
  GOOD
  ACCEPTABLE
}

enum BookStatus {
  WAITING_PUBLICATION_APPROVAL
  REJECTED
  AVAILABLE
  WAITING_EXCHANGE_APPROVAL
  TRADED
}

enum ExchangeStatus {
  REQUESTED
  ACCEPTED
  REFUSED
  WAITING_APPROVAL
  COMPLETED
  CANCELED
}

enum ModeratorRole {
  MODERATOR
  USER_MODERATOR
}

model User {
  id               Int          @id @default(autoincrement())
  name             String
  email            String       @unique
  password         String
  uniCard          String       @unique
  course           String
  contact          String
  rating           Float        @default(5.0)   
  status           UserStatus   @default(WAITING_APPROVAL)
  booksOwned       Book[]       @relation("UserBooks")
  ratingsGiven     Evaluation[] @relation("RatingGiver")
  ratingsReceived  Evaluation[] @relation("RatingReceiver")
  createdAt        DateTime     @default(now())
  booksLiked       Book[]       @relation("LikedBooks")
  
  // Relações para exchanges
  exchangesAsUser1   Exchange[] @relation("ExchangesAsUser1")
  exchangesAsUser2   Exchange[] @relation("ExchangesAsUser2")
}

model Moderator {
  id               Int           @id @default(autoincrement())
  name             String
  email            String        @unique
  password         String
  role             ModeratorRole @default(MODERATOR)
}

model Book {
  id               Int          @id @default(autoincrement())
  title            String
  author           String
  year             Int
  discipline       String
  condition        BookCondition
  description      String?
  status           BookStatus    @default(WAITING_PUBLICATION_APPROVAL)
  owner            User          @relation("UserBooks", fields: [ownerId], references: [id])
  ownerId          Int
  likedBy          User[]        @relation("LikedBooks")

  requesterExchanges Exchange[]  @relation("RequesterBookExchange")
  providerExchanges Exchange[]   @relation("ProviderBookExchange")

  createdAt        DateTime      @default(now())
}

model Exchange {
  id               Int      @id @default(autoincrement())
  provider         User     @relation("ExchangesAsUser1", fields: [providerId], references: [id])
  providerId       Int
  requester        User     @relation("ExchangesAsUser2", fields: [requesterId], references: [id])
  requesterId      Int

  requesterBook    Book   @relation("RequesterBookExchange", fields: [requesterBookId], references: [id])
  requesterBookId  Int
  providerBook     Book   @relation("ProviderBookExchange", fields: [providerBookId], references: [id])
  providerBookId   Int

  status           ExchangeStatus @default(REQUESTED)
  requestDate      DateTime       @default(now())
  completionDate   DateTime?
}

model Evaluation {
  id               Int      @id @default(autoincrement())
  rater            User     @relation("RatingGiver", fields: [raterId], references: [id])
  raterId          Int
  rated            User     @relation("RatingReceiver", fields: [ratedId], references: [id])
  ratedId          Int
  rating           Float    @default(5.0) 

  @@unique([raterId, ratedId])
}

// não utilizado no momento, mas pode ser útil no futuro
model Match {
  id               Int      @id @default(autoincrement())
  
  //user1            User     @relation("User1Matches", fields: [user1Id], references: [id])
  user1Id          Int
  //user2            User     @relation("User2Matches", fields: [user2Id], references: [id])
  user2Id          Int
  
  // Livros do user1 que interessam ao user2
  //booksUser1       Book[]   @relation("User1BooksInMatch")
  // Livros do user2 que interessam ao user1
  //booksUser2       Book[]   @relation("User2BooksInMatch")

  //exchanges        Exchange[] @relation("MatchExchanges")
  createdAt        DateTime @default(now())

  @@unique([user1Id, user2Id])
}