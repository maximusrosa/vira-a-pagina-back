// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookCondition {
  LIKE_NEW
  GOOD
  ACCEPTABLE
}

enum BookStatus {
  WAITING_PUBLICATION_APPROVAL
  AVAILABLE
  WAITING_EXCHANGE_APPROVAL
  TRADED
}

enum ExchangeStatus {
  REQUESTED
  ACCEPTED
  WAITING_APPROVAL
  COMPLETED
  CANCELED
}

enum ModeratorRole {
  MODERATOR
  USER_MODERATOR
}

model User {
  id               Int          @id @default(autoincrement())
  name             String
  email            String       @unique
  password         String
  uniCard          String       @unique
  course           String
  contact          String
  rating           Float        @default(5.0)   
  booksOwned       Book[]       @relation("UserBooks")
  ratingsGiven     Evaluation[] @relation("RatingGiver")
  ratingsReceived  Evaluation[] @relation("RatingReceiver")
  createdAt        DateTime     @default(now())
  booksLiked       Book[]       @relation("LikedBooks")
  
  // Relações para matches
  matchesAsUser1   Match[]      @relation("User1Matches")
  matchesAsUser2   Match[]      @relation("User2Matches")
}

model Moderator {
  id               Int           @id @default(autoincrement())
  email            String        @unique
  password         String
  role             ModeratorRole @default(MODERATOR)
}

model Book {
  id               Int          @id @default(autoincrement())
  title            String
  author           String
  year             Int
  discipline       String
  condition        BookCondition
  description      String?
  status           BookStatus    @default(WAITING_PUBLICATION_APPROVAL)
  owner            User          @relation("UserBooks", fields: [ownerId], references: [id])
  ownerId          Int
  likedBy          User[]        @relation("LikedBooks")

  requesterExchanges Exchange[]  @relation("RequesterBookExchange")
  providerExchanges Exchange[]   @relation("ProviderBookExchange")
  
  // Relações para matches
  matchesAsUser1Book Match[]     @relation("User1BooksInMatch")
  matchesAsUser2Book Match[]     @relation("User2BooksInMatch")
  
  createdAt        DateTime      @default(now())
}

model Exchange {
  id               Int      @id @default(autoincrement())
  match            Match    @relation("MatchExchanges", fields: [matchId], references: [id])
  matchId          Int

  requesterBooks   Book[]   @relation("RequesterBookExchange")
  providerBooks    Book[]   @relation("ProviderBookExchange")

  status           ExchangeStatus @default(REQUESTED)
  requestDate      DateTime       @default(now())
  completionDate   DateTime?
}

model Evaluation {
  id               Int      @id @default(autoincrement())
  rater            User     @relation("RatingGiver", fields: [raterId], references: [id])
  raterId          Int
  rated            User     @relation("RatingReceiver", fields: [ratedId], references: [id])
  ratedId          Int
  rating           Float    @default(5.0) 

  @@unique([raterId, ratedId])
}

model Match {
  id               Int      @id @default(autoincrement())
  
  user1            User     @relation("User1Matches", fields: [user1Id], references: [id])
  user1Id          Int
  
  user2            User     @relation("User2Matches", fields: [user2Id], references: [id])
  user2Id          Int
  
  // Livros do user1 que interessam ao user2
  booksUser1       Book[]   @relation("User1BooksInMatch")
  
  // Livros do user2 que interessam ao user1
  booksUser2       Book[]   @relation("User2BooksInMatch")
  
  exchanges       Exchange[] @relation("MatchExchanges")

  createdAt        DateTime @default(now())

  @@unique([user1Id, user2Id])
}