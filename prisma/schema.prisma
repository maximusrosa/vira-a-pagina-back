// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookCondition {
  LIKE_NEW
  GOOD
  ACCEPTABLE
}

enum BookStatus {
  AVAILABLE
  ON_HOLD
  TRADED
  WAITING_APPROVAL
}

enum ExchangeStatus {
  REQUESTED
  ACCEPTED
  COMPLETED
  CANCELED
}

enum ModeratorRole {
  MODERATOR
  USER_MODERATOR
}

model User {
  id               Int          @id @default(autoincrement())
  name             String
  email            String       @unique
  password         String
  uniCard          String       @unique
  course           String
  contact          String
  rating           Float        @default(5.0)   
  booksOwned       Book[]       @relation("UserBooks")
  providedExchanges Exchange[]  @relation("ProviderExchanges")
  requestedExchanges Exchange[] @relation("RequesterExchanges")
  ratingsGiven     Evaluation[] @relation("RatingGiver")
  ratingsReceived  Evaluation[] @relation("RatingReceiver")
  createdAt        DateTime     @default(now())
}

model Moderator {
  id               Int           @id @default(autoincrement())
  email            String        @unique
  password         String
  role             ModeratorRole @default(MODERATOR)
}

model Book {
  id               Int          @id @default(autoincrement())
  title            String
  author           String
  year             Int
  discipline       String
  condition        BookCondition
  description      String?
  status           BookStatus    @default(WAITING_APPROVAL)
  owner            User          @relation("UserBooks", fields: [ownerId], references: [id])
  ownerId          Int

  requesterExchanges Exchange[]  @relation("RequesterBookExchange")
  providerExchanges Exchange[]   @relation("ProviderBookExchange")
  
  createdAt        DateTime      @default(now())
}

model Exchange {
  id               Int            @id @default(autoincrement())

  requesterBook    Book           @relation("RequesterBookExchange", fields: [requesterBookId], references: [id])
  requesterBookId  Int
  requester        User           @relation("RequesterExchanges", fields: [requesterId], references: [id])
  requesterId      Int

  providerBook     Book           @relation("ProviderBookExchange", fields: [providerBookId], references: [id])
  providerBookId   Int
  provider         User           @relation("ProviderExchanges", fields: [providerId], references: [id])
  providerId       Int

  status           ExchangeStatus @default(REQUESTED)
  requestDate      DateTime       @default(now())
  completionDate   DateTime?
}

model Evaluation {
  id               Int      @id @default(autoincrement())
  rater            User     @relation("RatingGiver", fields: [raterId], references: [id])
  raterId          Int
  rated            User     @relation("RatingReceiver", fields: [ratedId], references: [id])
  ratedId          Int
  rating           Float    @default(5.0) 

  @@unique([raterId, ratedId])
}